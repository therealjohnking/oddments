# Build-time configuration for the public deployment. Copy to .env.local for
# local experiments; set these as build environment variables in CI/Cloudflare.
# Both are optional: without them the site builds and works, but canonical
# URLs fall back to localhost and analytics is disabled.

# The public origin — scheme + host only, no path, no trailing slash
# (e.g. https://oddments.example.com). Used for canonical URLs, Open Graph
# URLs, robots.txt, and sitemap.xml. Set this for any production build; the
# site is built to be served from an origin root.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Web Analytics beacon token (Cloudflare dashboard → Analytics &
# Logs → Web Analytics → add a site). Leave unset to ship zero analytics code.
NEXT_PUBLIC_CF_BEACON_TOKEN=
